# ==============================================================================
# SMART ACADEMIC MANAGEMENT SYSTEM (SAMS) — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to:
#   - apps/web/.env.local (for the Next.js web app)
#   - apps/ai-service/.env (for the Python FastAPI microservice)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WEB APPLICATION (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Authentication & PostgreSQL Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only key: NEVER expose to frontend client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Internal AI Microservice Connection (Server-to-Server)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=sams_dev_secret_internal_key_2026

# ------------------------------------------------------------------------------
# 2. AI / ML MICROSERVICE (apps/ai-service)
# ------------------------------------------------------------------------------
APP_ENV=development
PORT=8000
HOST=127.0.0.1
INTERNAL_API_KEY=sams_dev_secret_internal_key_2026
ALLOWED_ORIGINS=http://localhost:3000

# Face Recognition Calibration Thresholds
# NOTE: These values are initial baseline thresholds and MUST be calibrated
# against your webcam environment, lighting conditions, and chosen model weights.
FACE_SIMILARITY_MATCH_THRESHOLD=0.65
FACE_SIMILARITY_REVIEW_THRESHOLD=0.45
FACE_DETECTION_CONFIDENCE_THRESHOLD=0.80

# OR-Tools Optimization Solver Configuration
TIMETABLE_SOLVER_MAX_SECONDS=30
TIMETABLE_SOLVER_NUM_WORKERS=4
